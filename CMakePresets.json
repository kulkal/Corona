{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2022-x64",
      "displayName": "Visual Studio 2022 x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_SYSTEM_VERSION": "10.0.18362.0"
      }
    },
    {
      "name": "nri-x64",
      "displayName": "VS2022 x64 (experimental NRI backend)",
      "inherits": "vs2022-x64",
      "binaryDir": "${sourceDir}/out/build/nri-x64",
      "cacheVariables": {
        "CORONA_WITH_NRI": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "vs2022-x64",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "vs2022-x64",
      "configuration": "Release"
    },
    {
      "name": "nri-release",
      "configurePreset": "nri-x64",
      "configuration": "Release"
    }
  ]
}
