# : comments

# no .vs folder
.vs/

# no bin folder
bin/
!src/external/streamline-sdk/bin/
src/external/streamline-sdk/bin/*
!src/external/streamline-sdk/bin/x64/
src/external/streamline-sdk/bin/x64/*
!src/external/streamline-sdk/bin/x64/sl.interposer.dll
!src/external/streamline-sdk/bin/x64/sl.common.dll
!src/external/streamline-sdk/bin/x64/sl.pcl.dll
!src/external/streamline-sdk/bin/x64/sl.dlss.dll
!src/external/streamline-sdk/bin/x64/nvngx_dlss.dll
!src/external/streamline-sdk/bin/x64/sl.dlss_d.dll
!src/external/streamline-sdk/bin/x64/nvngx_dlssd.dll

# no obj folder
obj/

# runtime-local state and generated diagnostics
.claude/settings.local.json
assets/
config/
logs/
dumps/
_backups/
_downloads/
_captures/
.deps/
camera_state.cfg
debug.log
imgui.ini
sl.log
src/camera_state.cfg
src/imgui.ini
src/sl.log
src/external/_downloads/
src/external/_packages/

# vs filters
*.filters
# no .a files
*.a

*.user
__pycache__/
*.pyc
*.pyc.*

# but do track lib.a, even though you're ignoring .a files above
!lib.a

# only ignore the TODO file in the current directory, not subdir/TODO
/TODO

# ignore all files in the build/ directory
build/
out/

# ignore doc/notes.txt, but not doc/server/arch.txt
doc/*.txt

# ignore all .pdf files in the doc/ directory
doc/**/*.pdf
src/MyToyDX12Renderer.exe
src/MyToyDX12Renderer.pdb
src/MyToyDX12Renderer.ilk
src/MyToyDX12Renderer.exe
src/MyToyDX12Renderer.pdb

# Vendored NVIDIA NRI (experimental backend); formalize as submodule before merge
src/external/nri/
# scratch build/configure logs created during NRI bring-up
_*.log
