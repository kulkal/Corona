function corona_platformer_get_spine_sprite_class(asset)
    if asset == nil then
        return nil
    end
    local path = asset.path
    if path ~= nil and corona_platformer_spine_sprite_classes[path] ~= nil then
        return corona_platformer_spine_sprite_classes[path]
    end
    local name = asset.name
    if name ~= nil then
        for _, entry in pairs(corona_platformer_spine_sprite_classes) do
            if entry.name == name then
                return entry
            end
        end
    end
    return nil
end

function corona_platformer_spine_asset_is_playable(asset)
    local entry = corona_platformer_get_spine_sprite_class(asset)
    if entry == nil then
        return false
    end
    return entry.playable_candidate == true
end

